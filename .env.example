# Compose 内部会覆盖主机名；这里只列出需要人工填写或可能改的项。
# 复制为 .env 后使用：cp .env.example .env

# ── 必填 ──────────────────────────────────────────────
POSTGRES_PASSWORD=

# ── 运行环境 ──────────────────────────────────────────
# production 时关闭 /docs 与 OpenAPI，并收紧管理员口令。
APP_ENV=production
# 浏览器跨域来源（逗号分隔）。经本仓库 Nginx 同源反代时留空即可。
CORS_ALLOW_ORIGINS=
# API 在反代之后必须开启，登录限流才信任 X-Forwarded-For。
TRUST_PROXY=true

# ── PostgreSQL（compose 会把 HOST 指到 postgres 服务）──
POSTGRES_USER=postgres
POSTGRES_DB=advisor
POSTGRES_PORT=5432

# ── 业务策略（默认值即可用）─────────────────────────────
# 模拟交易的单笔充值上限与单笔申购下限。
# PORTFOLIO_MAX_DEPOSIT_AMOUNT=10000000
# PORTFOLIO_MIN_ORDER_AMOUNT=100

# ── 投顾助手（未配置密钥时 Agent 降级，业务 API 仍可用）──
# ADVISOR_MODEL_API_KEY=
# ADVISOR_MODEL_BASE_URL=https://api.deepseek.com
# ADVISOR_MODEL_NAME=deepseek-chat
# FUYAO_API_KEY=
# TUSHARE_TOKEN=
# AGENT_TURN_TIMEOUT_SECONDS=120
# AGENT_MAX_MESSAGE_CHARS=4000
# AGENT_CONTEXT_MESSAGE_LIMIT=20

# ── 管理员引导（scripts.bootstrap_admin 可读取）──────────
# FINANCE_ADMIN_PASSWORD=

# ── 投顾（留空则投顾降级，模拟交易仍可用）──────────────
# ADVISOR_MODEL_API_KEY=
# ADVISOR_MODEL_BASE_URL=https://api.deepseek.com
# ADVISOR_MODEL_NAME=deepseek-chat
# FUYAO_API_KEY=
# TUSHARE_TOKEN=
# AGENT_TURN_TIMEOUT_SECONDS=120
# AGENT_MAX_MESSAGE_CHARS=4000
# AGENT_CONTEXT_MESSAGE_LIMIT=20

